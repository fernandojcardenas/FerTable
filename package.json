{
  "name": "fertable",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "An original spreadsheet-database app with live sync (Next.js + Postgres).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include src/shared --include src/server server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "cleanup-files": "tsx scripts/cleanup-files.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "leaflet": "1.9.4",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
